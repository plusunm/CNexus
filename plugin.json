{
  "name": "brain-memory",
  "version": "5.0.0",
  "description": "Cognitive Stability v5.0 | Deterministic Router + Belief System + Reflection + Goal Lifecycle",
  "author": "Boss",
  "license": "MIT",
  "type": "memory",
  "slots": ["memory"],
  "entry": "memory_backend:BrainMemoryBackend",
  "tags": [
    "memory", "long-term", "local", "graph", "consolidation", "bio-inspired",
    "hebbian", "reconsolidation", "hyde", "provenance", "multi-layer"
  ],
  "openclaw": {
    "compat": {
      "pluginApi": "1.0",
      "minVersion": "2026.5.0"
    },
    "registry": {
      "clawhub": true,
      "github": true
    }
  },
  "dependencies": {
    "python": [
      "langchain-ollama>=0.1.0",
      "langchain-core>=0.2.0",
      "lancedb>=0.5.0",
      "kuzu>=0.8.0",
      "pyarrow",
      "numpy",
      "requests",
      "apscheduler>=3.10.0",
      "tqdm",
      "python-dateutil"
    ]
  },
  "config": {
    "ollama_host": "http://localhost:11434",
    "embedding_model": "nomic-embed-text",
    "llm_model": "llama3.2",
    "embedding_dim": 768,
    "auto_capture": true,
    "auto_recall": true,
    "use_hyde": true,
    "recall_top_k": 12,
    "consolidate_enabled": true,
    "consolidate_cron": "0 3 * * *",
    "scheduler_enabled": true,
    "importance_threshold": 0.52,
    "forget_alpha": 0.85,
    "hebbian_strength": 0.72,
    "reconsolidate_enabled": true,
    "deep_reconsolidate_prob": 0.0,
    "short_term_capacity": 32,
    "min_capture_len": 8,
    "enable_multi_hop": true,
    "enable_metabolic": true,
    "dedup_similarity": 0.88,
    "write_gate_threshold": 0.45,
    "graph_prune_confidence": 0.35,
    "compress_similarity": 0.90,
    "attention_half_life": 3600,
    "belief_compat_threshold": 0.72,
    "reflection_enabled": true,
    "agent_identity": "helpful cognitive agent"
  }
}
