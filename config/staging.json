{
  "version": "1.0.0-g1-staging",
  "embedding_model": "nomic-embed-text",
  "llm_model": "llama3.2",
  "ollama_host": "http://localhost:11434",
  "embedding_fallback": "hash",
  "runtime_mode": "g2",
  "vector_dim": 768,
  "recall_top_k": 12,
  "governance_interval_seconds": 3600,
  "importance_threshold": 0.48,
  "write_gate_threshold": 0.45,
  "attention_half_life_hours": 4.0,
  "forget_alpha": 0.85,
  "enable_multi_hop": true,
  "enable_metabolic": true,
  "memory_management": {
    "max_total_memories": 5000,
    "max_per_layer": {
      "episodic": 3000,
      "semantic": 1500,
      "narrative": 500,
      "working": 200
    },
    "protected_layers": ["identity", "goal", "belief"],
    "protected_importance_min": 0.72,
    "metabolic_decay_rate": 0.02,
    "forget_decay_threshold": 0.12,
    "min_importance_retain": 0.22,
    "recall_access_cap": 50,
    "stale_days": 7
  },
  "auto_capture": true,
  "auto_recall": true,
  "personality": {
    "dna": {
      "curiosity": 0.78,
      "emotional_stability": 0.85
    },
    "narrative": {
      "auto_update": true,
      "max_timeline_events": 50
    }
  },
  "governance": {
    "drift_warning_threshold": 0.18,
    "drift_critical_threshold": 0.45,
    "max_entropy": 0.65,
    "governance_interval_hours": 6
  },
  "cdg": {
    "min_reality_coupling": 0.65,
    "max_drift_tolerance": 0.30,
    "mutation_budget_per_cycle": 12.0,
    "attractor_lock_in_threshold": 0.8,
    "reflection_depth_limit": 5,
    "self_rewrite_rate_limit": 0.7,
    "reality_window": 60,
    "max_trajectory_records": 256,
    "energy_alpha": 0.3,
    "energy_beta": 0.5,
    "energy_gamma": 1.0,
    "stable_v_threshold": 0.3,
    "soft_v_threshold": 0.6,
    "d_v_soft_threshold": 0.02,
    "d_v_hard_threshold": 0.08,
    "oscillation_history_max": 64,
    "oscillation_window": 5,
    "lyapunov_eps": 0.005,
    "trajectory_var_eps": 0.01,
    "gradient_step_soft": 0.12,
    "gradient_step_hard": 0.28,
    "gradient_weaken_factor": 0.35,
    "reference_alpha": 0.3,
    "reference_alpha_min": 0.1,
    "reference_lag": 5,
    "reference_v_eps": 0.12,
    "reference_drift_eps": 0.08,
    "reference_rcs_eps": 0.15,
    "external_dominance_theta": 0.5,
    "reference_entropy_floor": 0.05,
    "exogenous_default_v": 0.0,
    "exogenous_default_drift": 0.0,
    "exogenous_default_rcs": 0.7,
    "enable_governance_audit": true,
    "enable_epistemic_suggestion": true,
    "epistemic_suggestion_interval": 50,
    "advisory_mutation_floor": 4.8,
    "epistemic_recover_stable_cycles": 2,
    "enable_gtbs_shadow": true,
    "gtbs_shadow_persist": true,
    "enable_gtbs_capture": true
  },
  "gtbs": {
    "enable_write_intent_shadow": true,
    "enable_write_intent_soft_gate": true,
    "enable_write_intent_tx_rollback": true
  },
  "safety": {
    "write_gate_threshold": 0.65,
    "mutation_max_daily_delta": 0.012,
    "constitution_enforcement": true,
    "audit_enabled": true
  }
}
