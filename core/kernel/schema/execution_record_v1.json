{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cnexus://execution-record/v1",
  "title": "ExecutionRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "trace_id",
    "intent_type",
    "result",
    "identity",
    "graph",
    "nodes",
    "edges",
    "state_projection",
    "causal_projection",
    "explain_projection",
    "replay_signature",
    "audit_log",
    "events",
    "derivation",
    "elapsed_ms"
  ],
  "properties": {
    "version": { "const": "execution-record-v1" },
    "trace_id": { "type": "string", "minLength": 1 },
    "intent_type": { "type": "string", "minLength": 1 },
    "result": {},
    "identity": { "type": ["string", "null"] },
    "graph_invariant": { "type": ["string", "null"] },
    "graph": { "type": ["object", "null"] },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "equivalence": { "type": ["object", "null"] },
    "state_projection": { "type": "object" },
    "causal_projection": { "type": "object" },
    "explain_projection": { "type": "object" },
    "replay_signature": { "type": ["string", "null"] },
    "audit_log": { "type": "object" },
    "audit": { "type": "object" },
    "events": { "type": "array" },
    "derivation": { "type": "object" },
    "elapsed_ms": { "type": "number" }
  }
}
