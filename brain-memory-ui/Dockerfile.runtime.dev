# CNexus Runtime — internal / L1–L2 dev image (full source)

# Build: docker build -f brain-memory-ui/Dockerfile.runtime.dev -t cnexus-runtime:dev .



FROM python:3.11-slim



WORKDIR /app



ENV PYTHONDONTWRITEBYTECODE=1 \

    PYTHONUNBUFFERED=1 \

    PYTHONPATH=/app \

    BRAIN_MEMORY_ROOT=/app \

    BM_MEMORY_DIR=/data/memory \

    CNEXUS_ENV=development \

    CNEXUS_DEPLOY_LEVEL=dev



COPY requirements.txt ./requirements.txt

COPY brain-memory-ui/api/requirements.txt ./api-requirements.txt

RUN pip install --no-cache-dir -r requirements.txt -r api-requirements.txt



COPY . .



WORKDIR /app/brain-memory-ui



EXPOSE 8000



HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \

  CMD python -c "import httpx; httpx.get('http://127.0.0.1:8000/health', timeout=3).raise_for_status()"



CMD ["python", "-m", "api.main"]

